usr/lib/*/libqgcodeeditor_qt5.so.*
usr/lib/*/libqgcodeeditor_qt6.so
usr/lib/*/libqgcodeeditor_qt6.so.*
usr/include/*/qt5/QGCodeEditor/QGCodeEditor.h
usr/include/*/qt5/QGCodeEditor/QGCodeSyntaxHighlighter.h
usr/include/*/qt6/QGCodeEditor/QGCodeEditor.h
